def run_set_benchmark(n: int, rounds: int) -> int:
    checksum: int = 0
    r: int = 0
    while r < rounds:
        s1: set[int] = set()
        s2: set[int] = set()
        s3: set[int] = set()

        i: int = 0
        while i < n:
            v1: int = (i * 2654435761 + r * 97) % (n * 2)
            v2: int = (i * 1597334677 + r * 131) % (n * 2)
            v3: int = (i * 2246822519 + r * 53) % (n * 2)
            s1.add(v1)
            s2.add(v2)
            s3.add(v3)
            i = i + 1

        u12: set[int] = s1 | s2
        inter12: set[int] = s1 & s2
        diff12: set[int] = s1 - s2
        sym12: set[int] = s1 ^ s2

        u_all: set[int] = u12.union(s3)
        inter_all: set[int] = inter12.intersection(s3)
        diff_all: set[int] = diff12.difference(s3)
        sym_all: set[int] = sym12.symmetric_difference(s3)

        if inter12 <= s1 and u12 >= s2:
            checksum = checksum + 1
        if diff12.isdisjoint(inter12):
            checksum = checksum + 1

        work: set[int] = s1.copy()
        work |= s2
        work -= inter_all
        work ^= sym_all

        j: int = 0
        hits: int = 0
        while j < n:
            probe: int = (j * 3266489917 + r) % (n * 2)
            if probe in work:
                hits = hits + 1
                work.discard(probe)
            j = j + 1

        total_rem: int = 0
        for val in work:
            total_rem = (total_rem + val) % 1000000007

        checksum = (checksum + len(u_all) + len(inter_all) + len(diff_all) + hits + total_rem) % 1000000007
        r = r + 1

    return checksum

def main() -> None:
    res: int = run_set_benchmark(4000, 25)
    print(res)

main()
