def pi_wallis(n: int) -> float:
    pi: float = 2.0
    for i in range(1, n):
        left: float = (2.0 * i) / (2.0 * i - 1.0)
        right: float = (2.0 * i) / (2.0 * i + 1.0)
        pi = pi * left * right
    return pi

def main() -> None:
    print("Calculate Pi using Wallis product")
    print("{:.16f}".format(pi_wallis(2**21 + 2**20)))

main()
