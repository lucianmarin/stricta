def pi_wallis(n: int) -> None:
    pi: float = 2.0
    for i in range(1, n):
        left: float = (2.0 * i) / (2.0 * i - 1.0)
        right: float = (2.0 * i) / (2.0 * i + 1.0)
        pi = pi * left * right

def main() -> None:
    print("Calculate Pi using Wallis product")
    pi_wallis(2**21 + 2**20)

main()
