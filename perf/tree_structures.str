class BSTNode:
    key: int
    val: int
    left: BSTNode | None
    right: BSTNode | None
    size: int
    subtree_sum: int

    def __init__(self, key: int, val: int) -> None:
        self.key = key
        self.val = val
        self.left = None
        self.right = None
        self.size = 1
        self.subtree_sum = val

def bst_insert_node(node: BSTNode | None, key: int, val: int) -> tuple[int, int]:
    if node is None:
        return (0, 0)
    if key == node.key:
        diff: int = val - node.val
        node.val = val
        node.subtree_sum = node.subtree_sum + diff
        return (0, diff)
    elif key < node.key:
        if node.left is None:
            node.left = BSTNode(key, val)
            node.size = node.size + 1
            node.subtree_sum = node.subtree_sum + val
            return (1, val)
        ds, dsum = bst_insert_node(node.left, key, val)
        node.size = node.size + ds
        node.subtree_sum = node.subtree_sum + dsum
        return (ds, dsum)
    else:
        if node.right is None:
            node.right = BSTNode(key, val)
            node.size = node.size + 1
            node.subtree_sum = node.subtree_sum + val
            return (1, val)
        ds, dsum = bst_insert_node(node.right, key, val)
        node.size = node.size + ds
        node.subtree_sum = node.subtree_sum + dsum
        return (ds, dsum)

def bst_insert(root: BSTNode | None, key: int, val: int) -> BSTNode:
    if root is None:
        return BSTNode(key, val)
    bst_insert_node(root, key, val)
    return root

def bst_range_sum(node: BSTNode | None, low: int, high: int) -> int:
    if node is None:
        return 0
    total: int = 0
    if low <= node.key and node.key <= high:
        total = total + node.val
    if low < node.key and node.left is not None:
        total = total + bst_range_sum(node.left, low, high)
    if node.key < high and node.right is not None:
        total = total + bst_range_sum(node.right, low, high)
    return total

def bst_mirror_weighted(node: BSTNode | None, depth: int) -> int:
    if node is None:
        return 0
    l_val: int = bst_mirror_weighted(node.left, depth + 1)
    r_val: int = bst_mirror_weighted(node.right, depth + 1)
    return (node.key * depth + node.val + l_val + r_val) % 1000000007

class RoseNode:
    id_val: int
    weight: int
    children: list[RoseNode]

    def __init__(self, id_val: int, weight: int) -> None:
        self.id_val = id_val
        self.weight = weight
        self.children = []

    def add_child(self, child: RoseNode) -> None:
        self.children.append(child)

def build_rose_tree(branch_factor: int, depth: int, seed: int) -> RoseNode:
    root = RoseNode(seed, (seed * 31 + depth) % 997)
    if depth <= 0:
        return root
    i: int = 0
    while i < branch_factor:
        child_seed: int = (seed * branch_factor + i + 1) % 1000003
        root.add_child(build_rose_tree(branch_factor, depth - 1, child_seed))
        i = i + 1
    return root

def eval_rose_tree(node: RoseNode, mult: int) -> int:
    acc: int = (node.id_val * mult + node.weight) % 1000000007
    c_i: int = 0
    ch: list[RoseNode] = node.children
    n_ch: int = len(ch)
    while c_i < n_ch:
        acc = (acc + eval_rose_tree(ch[c_i], (mult + c_i + 1) % 257)) % 1000000007
        c_i = c_i + 1
    return acc

def main() -> None:
    checksum: int = 0
    r: int = 0
    while r < 20:
        root: BSTNode | None = None
        i: int = 0
        while i < 2000:
            k: int = (i * 2654435761 + r * 1013904223) % 10000
            v: int = (i * 41 + r * 19) % 5000
            root = bst_insert(root, k, v)
            i = i + 1

        q: int = 0
        q_sum: int = 0
        while q < 200:
            low: int = (q * 47 + r * 13) % 8000
            high: int = low + 1500
            q_sum = (q_sum + bst_range_sum(root, low, high)) % 1000000007
            q = q + 1

        m1: int = bst_mirror_weighted(root, 1)
        m2: int = bst_mirror_weighted(root, 1)

        rose: RoseNode = build_rose_tree(4, 5, r + 1)
        r_eval: int = eval_rose_tree(rose, 3)

        if root is not None:
            checksum = (checksum + root.size + root.subtree_sum + q_sum + m1 + m2 + r_eval) % 1000000007
        r = r + 1

    print(checksum)

main()
