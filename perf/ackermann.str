@extern("getpid")
def _getpid() -> int:
    pass

def ackermann(m: int, n: int) -> int:
    if m == 0:
        return n + 1
    if n == 0:
        return ackermann(m - 1, 1)
    return ackermann(m - 1, ackermann(m, n - 1))

def main() -> None:
    print("Ackermann function")
    total: int = 0
    for _ in range(400):
        # Runtime-opaque zero: keeps the call in the loop without adding a
        # per-recursion counter.
        salt: int = _getpid() - _getpid()
        total = total + ackermann(3, 6 + salt)
    print(total)

main()
