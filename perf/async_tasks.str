async def worker(tid: int, steps: int) -> int:
    acc: int = tid
    for i in range(steps):
        acc = (acc * 1103515245 + 12345 + i) & 2147483647
        _coro_yield()
    return acc

def main() -> None:
    n: int = 800
    steps: int = 2000
    tasks: list[Task[int]] = []
    for i in range(n):
        tasks.append(worker(i + 1, steps))
    while True:
        all_done: bool = True
        for i in range(n):
            if not _task_is_done(tasks[i]):
                _task_step(tasks[i])
                if not _task_is_done(tasks[i]):
                    all_done = False
        if all_done:
            break
    total: int = 0
    while len(tasks) > 0:
        total += await tasks.pop(0)
    print(total)

main()
