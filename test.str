# Stricta Test Program

def test_arithmetic() -> None:
    x: int = 10
    y: int = 3
    print("Arithmetic:")
    print("x + y =", x + y)
    print("x - y =", x - y)
    print("x * y =", x * y)
    print("x / y =", x / y)
    print("x % y =", x % y)

def test_comparisons() -> None:
    print("Comparisons:")
    x: int = 5
    y: int = 10
    print("x < y:", x < y)
    print("x > y:", x > y)
    print("x == y:", x == y)
    print("x != y:", x != y)

def test_lists() -> None:
    print("Lists:")
    lst: list[int] = [1, 2]
    lst.append(3)
    lst.append(4)
    print("lst:", lst)
    print("len(lst):", len(lst))
    print("lst[0]:", lst[0])
    print("lst[-1]:", lst[-1])
    print("lst[1:3]:", lst[1:3])

def test_strings() -> None:
    print("Strings:")
    s: str = "hello" + " world"
    print("s:", s)
    print("len(s):", len(s))
    print("s[0]:", s[0])
    print("s[6:11]:", s[6:11])
    parts: list[str] = s.split()
    print("split parts:", parts)

def test_loops() -> None:
    print("Loops:")
    i: int = 0
    while i < 3:
        print("while loop count:", i)
        i = i + 1

    for j in range(3):
        print("for j in range(3):", j)

    for item in ["apple", "banana"]:
        print("for item in list:", item)

class Greeter:
    prefix: str

    def __init__(self, prefix: str) -> None:
        self.prefix = prefix

    def greet(self, target: str) -> None:
        print(self.prefix + ", " + target + "!")

def test_classes() -> None:
    print("Classes:")
    g = Greeter("Hello")
    g.greet("Stricta")
    print("g.prefix attribute access:", g.prefix)

def test_bigint() -> None:
    print("BigInts:")
    a: bigint = 123456789012345678901234567890
    b: bigint = 987654321098765432109876543210
    print("a + b =", a + b)
    print("b - a =", b - a)
    print("a * b =", a * b)
    c: bigint = bigint(2) ** bigint(100)
    print("2 ** 100 =", c)
    print("c - 1 =", c - bigint(1))
    print("-c =", -c)
    d: bigint = 1000000000000000000000000000000
    print("d // 3 =", d // bigint(3))
    print("d % 3 =", d % bigint(3))
    e: bigint = -123456789012345678901234567890
    print("e =", e)
    print("abs(e) =", abs(e))
    print("e + 10 =", e + bigint(10))
    print("a > b:", a > b)
    print("a < b:", a < b)
    print("a == a:", a == a)
    print("a != b:", a != b)
    print("e < 0:", e < bigint(0))
    print("e > 0:", e > bigint(0))

class Ctx:
    entered: bool
    exited: bool
    info: str

    def __init__(self) -> None:
        self.entered = False
        self.exited = False
        self.info = ""

    def __enter__(self) -> int:
        self.entered = True
        return 42

    def __exit__(self, a: str | None, b: str | None, c: str | None) -> bool:
        self.exited = True
        if a is None:
            self.info = "ok"
        else:
            self.info = "exc"
        return False

def test_with() -> None:
    print("With statement:")
    c = Ctx()
    with c as val:
        print("  val:", val)
        print("  entered:", c.entered)
    print("  exited:", c.exited)
    print("  info:", c.info)

def main() -> None:
    test_arithmetic()
    test_comparisons()
    test_lists()
    test_strings()
    test_loops()
    test_classes()
    test_bigint()
    test_with()

main()
