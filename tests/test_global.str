x: int = 10

def foo() -> None:
    global x
    print(x)
    x = 20

print("before:", x)
foo()
print("after:", x)

y: int = 100

def bar() -> None:
    global y
    y = y + 1

print("y before:", y)
bar()
print("y after:", y)

count: int = 0
results: list[int] = []

def increment() -> None:
    global count
    count = count + 1
    results.append(count)

increment()
increment()
increment()
print("count:", count)
print("results:", results)
