MOD_NAME: str = __name__.copy()

def greet(name: str, greeting: str = "Hello", punct: str = "!") -> str:
    return f"{greeting}, {name}{punct}"

class Box:
    width: int
    height: int

    def __init__(self, width: int = 1, height: int = 2):
        self.width = width
        self.height = height

    def area(self) -> int:
        return self.width * self.height
