class Vec:
    x: int
    y: int

    def __init__(self, x = 0, y = 0):
        self.x = x
        self.y = y

class Shape:
    kind: str

    def __init__(self, kind = "shape"):
        self.kind = kind

class Circle(Shape):
    radius: int

    def __init__(self, radius: int):
        self.kind = "circle"
        self.radius = radius

    def diameter(self):
        return self.radius * 2

class Box:
    v: int

    def __init__(self, v: int):
        self.v = v

    def doubled(self):
        return self.v * 2

# 1. Return type inference (including recursive, optional, generator, nested)
def square(x: int):
    return x * x

def fact(n: int):
    if n <= 1:
        return 1
    return n * fact(n - 1)

def maybe_pos(x: int):
    if x <= 0:
        return None
    return x

def gen_nums(n: int):
    for i in range(n):
        yield i

def outer(a: int):
    def inner(b: int):
        return a + b
    return inner(10)

# 6. General module-global inference
ORIGIN = Vec(3, 4)
PRIMES = [2, 3, 5, 7]
COMPUTED = square(6)

def apply_fn(fn: Callable[[int], int], x: int):
    return fn(x)

def test_all():
    assert square(5) == 25
    assert fact(5) == 120
    assert COMPUTED == 36
    assert ORIGIN.x + ORIGIN.y == 7
    assert outer(5) == 15

    r1 = maybe_pos(7)
    r2 = maybe_pos(-3)
    assert r1 is not None
    assert r2 is None
    if r1 is not None:
        assert r1 == 7

    g = gen_nums(4)
    assert g == [0, 1, 2, 3]

    # 2. Deferred empty-container inference
    nums = []
    nums.append(10)
    nums.append(20)
    assert nums == [10, 20]

    tags = set()
    tags.add("a")
    tags.add("b")
    assert "a" in tags and len(tags) == 2

    scores = {}
    scores["alice"] = 99
    assert scores["alice"] == 99

    # 3. Optional auto-promotion
    best = None
    if square(2) == 4:
        best = 42
    assert best is not None
    if best is not None:
        assert best == 42

    # 4. Bidirectional lambda inference
    doubled = map(lambda x: x * 2, [1, 2, 3])
    assert doubled == [2, 4, 6]
    evens = filter(lambda x: x % 2 == 0, [1, 2, 3, 4])
    assert evens == [2, 4]
    vecs = sorted([Vec(3, 0), Vec(1, 0), Vec(2, 0)], key=lambda v: v.x)
    assert vecs[0].x == 1 and vecs[1].x == 2 and vecs[2].x == 3
    assert apply_fn(lambda x: x + 1, 41) == 42

    # 5. isinstance() flow narrowing
    s: Shape = Circle(9)
    if isinstance(s, Circle):
        assert s.radius == 9
        assert s.diameter() == 18

    # 7. Non-escaping local list & class + nonneg range indexing
    local_list = [1, 2, 3, 4]
    total = 0
    for i in range(len(local_list)):
        total = total + local_list[i]
    assert total == 10

    box = Box(21)
    assert box.doubled() == 42

# 8. Call-site monomorphization (top-level, recursive, default args, nested, non-vtable method)
def first_elem(xs):
    return xs.pop(0)

def add_pair(a, b):
    return a + b

def scale_val(x, factor=2):
    return x * factor

class Helper:
    tag: str

    def __init__(self, tag: str):
        self.tag = tag

    def identity(self, x):
        return x

# 9. Cross-method class field inference (self.x = None & self.items = [])
class TreeNode:
    def __init__(self, val: int):
        self.val = val
        self.left = None
        self.right = None

    def attach(self, l: TreeNode, r: TreeNode):
        self.left = l
        self.right = r

class Bag:
    def __init__(self):
        self.items = []

    def add(self, x: int):
        self.items.append(x)

# 10. Bidirectional hints + return-path checking
def make_empty_ints() -> list[int]:
    return []

def sum_ints(xs: list[int]) -> int:
    s = 0
    for x in xs:
        s = s + x
    return s

def check_both_non_none(a: int | None, b: int | None) -> int:
    if a is None or b is None:
        return -1
    return a + b

def match_opt_int(v: int | None) -> int:
    match v:
        case None:
            return 0
        case x:
            return x * 10

def test_extended_inference():
    # Bounds-check elimination
    arr = [10, 20, 30, 40]
    for i in range(len(arr)):
        arr[i] = arr[i] + 1
    assert arr == [11, 21, 31, 41]

    idx = 2
    if 0 <= idx < len(arr):
        assert arr[idx] == 31
    if idx < len(arr) and idx >= 0:
        assert arr[idx] == 31
    assert 0 <= idx < len(arr)
    assert arr[idx] == 31

    # Call-site monomorphization
    assert first_elem([7, 8]) == 7
    assert first_elem(["hi", "yo"]) == "hi"
    assert first_elem([Vec(5, 6)]).x == 5
    assert add_pair(3, 4) == 7
    assert add_pair(1.5, 2.5) == 4.0
    assert add_pair("a", "b") == "ab"
    assert scale_val(5) == 10
    assert scale_val(2.5) == 5.0

    def local_id(v):
        return v
    assert local_id(99) == 99
    assert local_id("ok") == "ok"

    h = Helper("h")
    assert h.identity(123) == 123
    assert h.identity("abc") == "abc"

    # Richer flow narrowing
    ov: Vec | None = Vec(4, 5)
    if ov is not None and ov.x > 0:
        assert ov.x + ov.y == 9
    if ov is None or ov.x == 4:
        assert True
    else:
        assert False

    ov2: Vec | None = Vec(2, 3)
    if ov2 is None:
        assert False
    elif ov2.y == 3:
        assert ov2.x == 2

    sh: Shape = Circle(7)
    assert isinstance(sh, Circle)
    assert sh.radius == 7 and sh.diameter() == 14

    assert check_both_non_none(3, 4) == 7
    assert check_both_non_none(None, 4) == -1
    assert match_opt_int(None) == 0
    assert match_opt_int(5) == 50

    # Deeper bidirectional hints
    assert make_empty_ints() == []
    indirect = []
    assert sum_ints(indirect) == 0
    tern_l = [] if True else [1, 2]
    assert tern_l == []
    tern_o = None if False else 9
    if tern_o is not None:
        assert tern_o == 9
    mixed = [None, 10, 20]
    assert len(mixed) == 3
    nones: list[int | None] = [None for _ in range(3)]
    assert len(nones) == 3

    # Cross-method class fields
    root = TreeNode(1)
    left = TreeNode(2)
    right = TreeNode(3)
    root.attach(left, right)
    rl = root.left
    rr = root.right
    if rl is not None and rr is not None:
        assert rl.val + rr.val == 5

    bag = Bag()
    bag.add(11)
    bag.add(22)
    assert bag.items == [11, 22]

    # Stack-allocated listcomp + fused any/all
    sq = [k * k for k in range(5)]
    assert sq == [0, 1, 4, 9, 16]
    assert any(x > 10 for x in sq)
    assert all(x >= 0 for x in sq)
    assert not all(x > 0 for x in sq)

# 11. Generic monomorphized classes
class GenBox:
    def __init__(self, v):
        self.v = v

    def get(self):
        return self.v

class GenPair:
    def __init__(self, a, b):
        self.a = a
        self.b = b

    def first(self):
        return self.a

# 12. Call-site monomorphization for None / empty-container defaults
def unwrap_or_default(x = None, fallback = 0):
    if x is not None:
        return x
    return fallback

def push_and_len(xs = [], item = 0):
    xs.append(item)
    return len(xs)

# 13. First-class generic function with bidirectional Callable hint
def inc_any(x):
    return x + 1

# 14. Order-independent recursive return inference (recursive call before base case)
def fact_rev(n: int):
    if n > 1:
        return n * fact_rev(n - 1)
    return 1

def test_new_inference():
    # 1. Generic monomorphized classes
    bi = GenBox(42)
    bf = GenBox(3.5)
    assert bi.get() == 42
    assert bf.get() == 3.5
    p1 = GenPair(10, "ok")
    p2 = GenPair(3.5, True)
    assert p1.first() == 10 and p1.b == "ok"
    assert p2.first() == 3.5 and p2.b == True

    # 2. Call-site monomorphization for None / empty defaults
    assert unwrap_or_default(7, 99) == 7
    opt_i: int | None = None
    assert unwrap_or_default(opt_i, 99) == 99
    assert push_and_len([1, 2], 3) == 3

    # 3. First-class generic functions with bidirectional hints
    assert apply_fn(inc_any, 41) == 42
    fn_ref: Callable[[int], int] = inc_any
    assert fn_ref(9) == 10

    # 4. Mixed None & widening in dict/set literals
    dm = {"a": None, "b": 42}
    assert len(dm) == 2
    assert dm["a"] is None
    sm = {None, 5}
    assert len(sm) == 2

    # 5. Contextual numeric literal typing (including optional hints & negative signed bounds)
    b_u8: u8 = 255
    b_i8: i8 = -128
    opt_u8: u8 | None = 12
    opt_f32: f32 | None = 1.5
    u8_list: list[u8] = [0, 1, 255]
    assert b_u8 == u8(255)
    assert b_i8 == i8(-128)
    assert opt_u8 is not None and opt_f32 is not None
    assert len(u8_list) == 3

    # 6. Order-independent recursive return inference
    assert fact_rev(5) == 120

test_all()
test_extended_inference()
test_new_inference()
print("inference tests passed")
