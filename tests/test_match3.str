x: int = 99
match x:
    case 1:
        print("one")
    case 2:
        print("two")

print("after match")

v: bool = True
match v:
    case True:
        print("is true")
    case False:
        print("is false")

s: str = "hello"
match s:
    case "hi":
        print("hi")
    case "hello":
        print("hello there")
    case _:
        print("unknown")
